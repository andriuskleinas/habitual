# Supabase — copy to .env.local and fill in (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical base URL: OG tags, robots/sitemap, server-rendered invite links.
# NOT used for magic-link sign-in (that resolves the origin from the request).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
